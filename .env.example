# ---- Data ----
SUBTITLE_DIR=data/subtitles
INDEX_DIR=index
MAX_MOVIES=100

# ---- Embeddings: auto | sentence-transformers | openai | tfidf ----
EMBEDDER=auto
ST_MODEL=sentence-transformers/all-MiniLM-L6-v2

# ---- LLM: auto | anthropic | openai | none ----
LLM_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- Email (used by the MCP email server) ----
# If SMTP_HOST is empty or EMAIL_DRY_RUN=true, emails are written to ./outbox as .eml files.
EMAIL_DRY_RUN=true
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_STARTTLS=true
